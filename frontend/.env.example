# Base URL of the Go backend (no trailing slash).
# Local:      http://localhost:8080
# Production: your Render URL, e.g. https://inventory-api.onrender.com
#
# Vite bakes VITE_* variables into the JavaScript at BUILD time, so after
# changing it you must rebuild (on Vercel: redeploy).
VITE_API_BASE_URL=http://localhost:8080
