# Copy to .env and adjust. docker compose reads .env automatically.
# These are LOCAL DEVELOPMENT values only.

POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=inventory
POSTGRES_PORT=5432
API_PORT=8080
LOG_LEVEL=info

# Signs login tokens. Must be at least 32 characters. Generate a random one
# in PowerShell (uses a cryptographically secure random generator):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789
JWT_TTL=1h

# How long stock stays reserved for an unpaid order.
RESERVATION_TTL=15m

# Payments (mock provider). Outcome can be overridden per request with
# POST /orders/{id}/pay {"simulate": "FAILURE"}.
PAYMENT_TIMEOUT=5s
MOCK_PAYMENT_OUTCOME=SUCCESS

# Browser origins allowed to call the API (comma-separated). The frontend
# dev server is http://localhost:5173; add your Vercel URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Redis (optional). Product cache + rate limiting.
PRODUCT_CACHE_TTL=5m
# Requests per minute per user (or per IP on public routes). 0 = off.
# The concurrency demo logs in 100+ buyers from one IP: raise this
# (e.g. 2000) before running it, or it will hit the limit - on purpose.
RATE_LIMIT_PER_MINUTE=100
# Used by tests (go test ./...). Tests that need Redis skip if unset.
TEST_REDIS_URL=redis://localhost:6379/15

# Background worker (cmd/worker).
WORKER_INTERVAL=10s
WORKER_BATCH_SIZE=100
# Wait this long after a reservation expired before resolving a
# PAYMENT_PENDING order with the provider. Must be > PAYMENT_TIMEOUT.
PAYMENT_RECONCILE_AFTER=1m

# Outbox publisher (worker). A failed publish is retried with exponential
# backoff; after OUTBOX_MAX_ATTEMPTS it is marked FAILED (dead letter).
OUTBOX_MAX_ATTEMPTS=10
# Demo only: make this share of publishes fail on purpose (0.0-1.0).
OUTBOX_FAILURE_RATE=0

# Used when running the Go binaries directly on your machine (go run ...).
# Note: localhost, because Postgres is reached through the published port.
DATABASE_URL=postgres://app:app_dev_password@localhost:5432/inventory?sslmode=disable

# Used by integration tests (go test ./...). Tests skip if this is unset.
TEST_DATABASE_URL=postgres://app:app_dev_password@localhost:5432/inventory_test?sslmode=disable
